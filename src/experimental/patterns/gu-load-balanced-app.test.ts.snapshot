                  {
                    "Ref": "TargetGroupTestgu1F401467"
                  },
                  "           --region eu-west-1           --targets Id=$INSTANCE_ID,Port=3000           --query \\"TargetHealthDescriptions[0].TargetHealth.State\\")\\n      done\\n\\n      echo \\"Instance running build 123 is healthy in target group.\\"\\n      \\n# GuEc2AppExperimental Instance Health Check End"
                ]
              ]
            }
