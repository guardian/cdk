                "Value": "
[PARSER]
    Name json
    Format json
    Time_Key time
    Time_Format %Y-%m-%dT%H:%M:%SZ",
              },
              {
                "Name": "GU_FLUENT_BIT_CONFIG",
                "Value": "
[FILTER]
    Name modify
    Match *
    Rename log message

[FILTER]
    Name parser
    Match *
    Key_Name message
    Parser json
    Reserve_Data On

[FILTER]
    Name modify
    Match *
    Add ShippedBy devx-logs
    Add gu:logging-sidecar sha256:0aa2921b14e44b8f00e057c68a0a3bafb944261a1c5aac36362bf2e1be8bef4d
    Add stack test-stack
    Add stage TEST
    Add app test-gu
    Add gu:repo guardian/cdk
    Add task test-gu

[OUTPUT]
    Name \${OUTPUT_PLUGIN}
    Match *",
              },
            ],
            "Essential": true,
            "FirelensConfiguration": {
