              "-c",
              "mkdir -p /tmp/guardian && printf '%s\\n' "$GU_FLUENT_BIT_PARSERS" > /tmp/guardian/guardian-parsers.conf && printf '%s\\n' "$GU_FLUENT_BIT_CONFIG" > /tmp/guardian/guardian.conf && exec /init/fluent_bit_init_entrypoint.sh",
